generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// --- LOGS IA (QUOTAS) ---
model AiLog {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  id_employe String
  employe    Employe  @relation(fields: [id_employe], references: [id_employe], onDelete: Cascade)
  prompt     String? 
  @@index([id_employe])
  @@map("ai_logs")
}

// --- UTILISATEURS ---
model Employe {
  id_employe          String    @id @default(cuid())
  nom                 String
  prenom              String
  email               String    @unique
  mot_de_passe        String
  doit_changer_mdp    Boolean   @default(false)
  role                Role      @default(DEVELOPPEUR)
  couleur_fond        String    @default("#ffffff")
  twoFactorCode       String?
  twoFactorExpires    DateTime?
  date_debut_validite DateTime?
  date_fin_validite   DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  participations      ParticipationProjet[]
  demandes_mdp        DemandeMdp[]
  ressources_empruntees Ressource[] @relation("Emprunt")
  signalements        Signalement[]
  historique_actions  HistoriqueAction[]
  reservations        ReservationSalle[]
  historique_ia       AiLog[]
  
  // 👇 NOUVEAU : RELATIONS TÂCHES
  tachesRecues        Tache[] @relation("TacheRecue")
  tachesDonnees       Tache[] @relation("TacheDonnee")

  @@map("employes")
}

model Tache {
  id_tache      String   @id @default(cuid())
  titre         String
  description   String?
  // SUPPRIMER LA LIGNE SUIVANTE QUI ETAIT EN DOUBLE :
  // statut        String   @default("A_FAIRE") 
  
  id_projet     String?
  projet        Projet?  @relation(fields: [id_projet], references: [id_projet])
  
  id_assigne_a  String   
  assigne_a     Employe  @relation("TacheRecue", fields: [id_assigne_a], references: [id_employe])
  
  id_assigne_par String  
  assigne_par    Employe @relation("TacheDonnee", fields: [id_assigne_par], references: [id_employe])

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  // GARDER UNIQUEMENT CELLE-CI (Version Enum) :
  statut        StatutTache @default(A_FAIRE)
  
  @@map("taches")
}

// --- AUTRES MODÈLES ---
model HistoriqueAction {
  id_action String   @id @default(cuid())
  action    String
  details   String?
  auteur    String
  createdAt DateTime @default(now())
  employe   Employe? @relation(fields: [auteur], references: [id_employe])
  @@map("historique_actions")
}

model DemandeMdp {
  id_demande String   @id @default(cuid())
  id_employe String
  statut     String   @default("EN_ATTENTE")
  createdAt  DateTime @default(now())
  token      String?  @unique
  expiresAt  DateTime?
  employe    Employe  @relation(fields: [id_employe], references: [id_employe], onDelete: Cascade)
  @@map("demandes_mdp")
}

model Projet {
  id_projet      String     @id @default(cuid())
  nom_projet     String
  description    String?
  date_debut     DateTime
  date_fin       DateTime?
  statut         StatutProjet @default(EN_COURS)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  participations ParticipationProjet[]
  reservations   ReservationSalle[]
  
  // 👇 AJOUTE CETTE LIGNE :
  taches         Tache[] 

  @@map("projets")
}

model ParticipationProjet {
  id_participation String   @id @default(cuid())
  id_employe       String
  id_projet        String
  date_assignation DateTime @default(now())
  role_dans_projet String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  employe          Employe  @relation(fields: [id_employe], references: [id_employe], onDelete: Cascade)
  projet           Projet   @relation(fields: [id_projet], references: [id_projet], onDelete: Cascade)
  @@unique([id_employe, id_projet])
  @@map("participation_projets")
}

model Ressource {
  id_ressource     String    @id @default(cuid())
  nom_ressource    String
  type             TypeRessource
  etat             EtatRessource @default(DISPONIBLE)
  localisation     String?
  numero_serie     String?       @unique
  date_acquisition DateTime?
  description      String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  id_emprunteur    String?
  emprunteur       Employe?      @relation("Emprunt", fields: [id_emprunteur], references: [id_employe], onDelete: SetNull)
  signalements     Signalement[]
  reservations     ReservationSalle[]
  @@map("ressources")
}

model Salle {
  id_salle     String   @id @default(cuid())
  nom_salle    String   @unique
  capacite     Int
  equipements  String?
  localisation String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  reservations ReservationSalle[]
  @@map("salles")
}

model ReservationSalle {
  id_reservation String   @id @default(cuid())
  id_employe     String?  
  employe        Employe? @relation(fields: [id_employe], references: [id_employe])
  
  id_salle       String?
  salle          Salle?   @relation(fields: [id_salle], references: [id_salle], onDelete: Cascade)
  
  id_ressource   String?
  ressource      Ressource? @relation(fields: [id_ressource], references: [id_ressource], onDelete: Cascade)

  id_projet      String?
  projet         Projet?  @relation(fields: [id_projet], references: [id_projet], onDelete: Cascade)
  
  date_debut     DateTime
  date_fin       DateTime
  objet          String?
  statut         StatutReservation @default(CONFIRMEE)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  @@map("reservation_salles")
}

model Signalement {
  id_signalement String   @id @default(cuid())
  description    String
  statut         String   @default("EN_ATTENTE")
  createdAt      DateTime @default(now())
  id_employe     String
  employe        Employe  @relation(fields: [id_employe], references: [id_employe], onDelete: Cascade)
  id_ressource   String
  ressource      Ressource @relation(fields: [id_ressource], references: [id_ressource], onDelete: Cascade)
  @@map("signalements")
}

enum Role {
  ADMIN
  CHEF_DE_PROJET
  RH
  DEVELOPPEUR
  STAGIAIRE
  EMPLOYE
}

enum StatutTache {
  A_FAIRE
  PLANIFIE
  TERMINE
  EN_COURS
}

enum StatutProjet {
  EN_COURS
  TERMINE
  EN_ATTENTE
  ANNULE
}

enum TypeRessource {
  EQUIPEMENT_LABORATOIRE
  MATERIEL_INFORMATIQUE
  EQUIPEMENT_REUNION
  MATERIEL_SPECIALISE
  VEHICULE
  AUTRE
}

enum EtatRessource {
  DISPONIBLE
  EN_UTILISATION
  EN_MAINTENANCE
  HORS_SERVICE
}

enum StatutReservation {
  CONFIRMEE
  EN_ATTENTE
  ANNULEE
}